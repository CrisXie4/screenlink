<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 骨架：MainActivity 主题（纯 Compose 应用，无 AppCompat/Material-XML 依赖，用框架主题） -->
    <style name="Theme.ScreenLink" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 骨架：分享透明对话框主题（DESIGN.md §3.4，windowIsFloating=true） -->
    <style name="Theme.ScreenLink.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
