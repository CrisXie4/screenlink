{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenLink",
  "version": "0.1.0",
  "identifier": "app.screenlink.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "ScreenLink",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": ["../../assets/scrcpy-server-v2.7.jar"],
    "externalBin": []
  }
}
